{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capability for the main window",
  "windows": [
    "main",
    "editor-*"
  ],
  "permissions": [
    "core:default",
    "opener:default",
    "fs:default",
    "fs:allow-temp-write",
    "fs:allow-temp-read",
    "dialog:default",
    {
      "identifier": "opener:allow-open-path",
      "allow": [
        {
          "path": "$LOGDIR/**"
        }
      ]
    },
    "core:webview:allow-set-webview-zoom",
    "core:webview:allow-create-webview-window"
  ]
}